.xp-item p{color:var(--ink-dim);font-size:14.5px;line-height:1.7;margin:0;}

/* projects - tilt cards */
.proj-grid{display:grid;grid-template-columns:1fr;gap:18px;}
@media(min-width:700px){.proj-grid{grid-template-columns:1fr 1fr;}}
.proj-card{
  background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:24px;
  transition:transform .12s ease,border-color .3s ease;will-change:transform;
