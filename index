.proj-card:hover{border-color:#3b4152;}
.proj-stack{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--slate);margin-bottom:10px;}
.proj-card h3{margin:0 0 10px;font-size:17px;font-weight:600;}
.proj-card p{color:var(--ink-dim);font-size:14px;line-height:1.65;margin:0 0 14px;}
.proj-link{font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--amber);text-decoration:none;}
.proj-link:hover{text-decoration:underline;}

/* skills */
.skill-cols{display:grid;grid-template-columns:1fr;gap:22px;}
@media(min-width:700px){.skill-cols{grid-template-columns:repeat(2,1fr);}}
.skill-group h4{font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--ink-dim);font-weight:500;margin:0 0 10px;}
.tag-row{display:flex;flex-wrap:wrap;gap:8px;}
.tag{border:1px solid var(--line);padding:6px 12px;border-radius:20px;font-size:13px;color:var(--ink);}

/* achievements */
.ach-list{list-style:none;margin:0;padding:0;display:grid;gap:14px;}
.ach-list li{display:flex;gap:14px;font-size:15px;color:var(--ink-dim);line-height:1.6;padding-left:0;}
.ach-list li::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--amber);margin-top:9px;flex:0 0 auto;}
.ach-list strong{color:var(--ink);font-weight:600;}

/* education */
