footer h2{font-size:30px;margin:0 0 14px;}
footer p{color:var(--ink-dim);max-width:44ch;margin:0 0 26px;}
.foot-links{display:flex;gap:18px;flex-wrap:wrap;font-family:'JetBrains Mono',monospace;font-size:13.5px;}
.foot-links a{text-decoration:none;color:var(--ink-dim);border-bottom:1px solid var(--line);padding-bottom:2px;transition:color .2s,border-color .2s;}
